{
  "name": "stackmanage-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @stackmanage/desktop dev",
    "build": "node ci/turbo.mjs build",
    "typecheck": "node ci/turbo.mjs typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:desktop": "pnpm --filter @stackmanage/desktop smoke",
    "test:browser:linux": "STACKMANAGE_BROWSER_E2E=1 vitest run apps/worker/test/caddy-browser.integration.test.ts",
    "legal:verify": "node scripts/verify-legal.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm legal:verify",
    "dist:linux:deb:x64": "pnpm build && electron-builder --linux deb --x64 --config electron-builder.yml",
    "dist:linux:deb:arm64": "pnpm build && electron-builder --linux deb --arm64 --config electron-builder.yml",
    "dist:linux:rpm": "pnpm build && electron-builder --linux rpm --x64 --arm64 --config electron-builder.yml",
    "dist:win:x64": "pnpm build && electron-builder --win nsis portable --x64 --config electron-builder.yml",
    "dist:linux:all": "pnpm build && electron-builder --linux deb rpm --x64 --arm64 --config electron-builder.yml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "esbuild": "0.28.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "electron-builder": "26.18.0"
  }
}
